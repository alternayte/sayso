{
  "components": {
    "schemas": {
      "AccessBody": {
        "additionalProperties": false,
        "properties": {
          "grants": {
            "items": {
              "$ref": "#/components/schemas/GrantBody"
            },
            "type": "array"
          },
          "teams": {
            "items": {
              "$ref": "#/components/schemas/TeamRoleBody"
            },
            "type": "array"
          },
          "users": {
            "items": {
              "$ref": "#/components/schemas/UserBody"
            },
            "type": "array"
          }
        },
        "required": [
          "teams",
          "grants",
          "users"
        ],
        "type": "object"
      },
      "Create-setup-sessionRequest": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "DiagnosticsBody": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/Result"
            },
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "checks"
        ],
        "type": "object"
      },
      "EntryBody": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "actor_kind": {
            "type": "string"
          },
          "actor_login": {
            "type": "string"
          },
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "details": {},
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "at",
          "actor_kind",
          "actor_login",
          "action",
          "target",
          "details"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "GrantBody": {
        "additionalProperties": false,
        "properties": {
          "granted_by": {
            "type": "string"
          },
          "login": {
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "maintainer",
              "viewer"
            ],
            "type": "string"
          }
        },
        "required": [
          "login",
          "role",
          "granted_by"
        ],
        "type": "object"
      },
      "HistoryBody": {
        "additionalProperties": false,
        "properties": {
          "new_value": {},
          "old_value": {},
          "revision": {
            "format": "int32",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "updated_by": {
            "type": "string"
          }
        },
        "required": [
          "revision",
          "old_value",
          "new_value",
          "updated_by",
          "updated_at"
        ],
        "type": "object"
      },
      "MeBody": {
        "additionalProperties": false,
        "properties": {
          "login": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "login",
          "name",
          "role"
        ],
        "type": "object"
      },
      "Put-grantRequest": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "admin",
              "maintainer",
              "viewer"
            ],
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "Put-settingRequest": {
        "additionalProperties": false,
        "properties": {
          "value": {}
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "Put-team-roleRequest": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "admin",
              "maintainer",
              "viewer"
            ],
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "Result": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "ms": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok",
          "detail",
          "ms"
        ],
        "type": "object"
      },
      "SettingBody": {
        "additionalProperties": false,
        "properties": {
          "default": {},
          "key": {
            "type": "string"
          },
          "revision": {
            "format": "int32",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "updated_by": {
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "key",
          "value",
          "default",
          "revision",
          "updated_by",
          "updated_at"
        ],
        "type": "object"
      },
      "SetupStateBody": {
        "additionalProperties": false,
        "properties": {
          "app_exists": {
            "type": "boolean"
          },
          "setup_session": {
            "type": "boolean"
          },
          "signed_in": {
            "type": "boolean"
          }
        },
        "required": [
          "app_exists",
          "setup_session",
          "signed_in"
        ],
        "type": "object"
      },
      "TeamRoleBody": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "admin",
              "maintainer",
              "viewer"
            ],
            "type": "string"
          },
          "team_slug": {
            "type": "string"
          }
        },
        "required": [
          "team_slug",
          "role"
        ],
        "type": "object"
      },
      "UserBody": {
        "additionalProperties": false,
        "properties": {
          "last_login_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "login": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "role_source": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "login",
          "name",
          "role",
          "role_source",
          "status",
          "last_login_at"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Sayso API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/access": {
      "get": {
        "operationId": "get-access",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "tags": [
          "access"
        ]
      }
    },
    "/api/v1/access/grants/{login}": {
      "delete": {
        "operationId": "delete-grant",
        "parameters": [
          {
            "in": "path",
            "name": "login",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "tags": [
          "access"
        ]
      },
      "put": {
        "operationId": "put-grant",
        "parameters": [
          {
            "in": "path",
            "name": "login",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Put-grantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "tags": [
          "access"
        ]
      }
    },
