{
  "$defs": {
    "CaseFinding": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        },
        "challenge": {
          "$ref": "#/$defs/Challenge"
        },
        "end_line": {
          "format": "int64",
          "type": "integer"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "start_line": {
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "category",
        "title",
        "path",
        "start_line",
        "end_line",
        "status",
        "blocking",
        "evidence"
      ],
      "type": "object"
    },
    "CasePull": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "number": {
          "format": "int64",
          "type": "integer"
        },
        "repository": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "number",
        "url",
        "author"
      ],
      "type": "object"
    },
    "CaseRound": {
      "additionalProperties": false,
      "properties": {
        "base_sha": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "risk": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "head_sha",
        "base_sha",
        "status",
        "verdict",
        "risk"
      ],
      "type": "object"
    },
    "CaseSignal": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "detail": {},
        "finding": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "actor",
        "detail",
        "at"
      ],
      "type": "object"
    },
    "Challenge": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "confirmed",
            "refuted",
            "downgraded"
          ],
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "reason"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "test",
            "trace",
            "call_path",
            "reasoning"
          ],
          "type": "string"
        },
        "test_path": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "type": "object"
    },
    "SkillRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "source": {
          "enum": [
            "repository",
            "skael",
            "builtin"
          ],
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "name",
        "sha256"
      ],
      "type": "object"
    },
    "SteeringReview": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "tags",
        "note",
        "author",
        "created_at"
      ],
      "type": "object"
    }
  },
  "$id": "https://sayso.dev/schemas/case.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config_snapshot": {},
    "exported_at": {
      "format": "date-time",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/CaseFinding"
      },
      "type": "array"
    },
    "prompt_ref": {},
    "pull_request": {
      "$ref": "#/$defs/CasePull"
    },
    "round": {
      "$ref": "#/$defs/CaseRound"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/CaseSignal"
      },
      "type": "array"
    },
    "skill_ref": {
      "$ref": "#/$defs/SkillRef"
    },
    "steering_review": {
      "$ref": "#/$defs/SteeringReview"
    },
    "version": {
      "description": "Format version, 1",
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "exported_at",
    "pull_request",
    "round",
    "config_snapshot",
    "skill_ref",
    "prompt_ref",
    "findings",
    "signals",
    "steering_review"
  ],
  "title": "Sayso steering case",
  "type": "object"
}
