# 32 random bytes in base64: openssl rand -base64 32
SAYSO_SECRET_KEY=
# A random value. The setup page asks for it before the GitHub App exists.
SAYSO_SETUP_TOKEN=
# The URL where people open Sayso. GitHub sends sign-in callbacks here.
SAYSO_BASE_URL=http://localhost:8080
# The URL that GitHub calls with webhooks.
SAYSO_PUBLIC_WEBHOOK_URL=
# GitHub logins that become admins at first sign-in, separated by commas.
SAYSO_BOOTSTRAP_ADMINS=
POSTGRES_PASSWORD=sayso
